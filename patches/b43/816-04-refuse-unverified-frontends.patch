 static int b43_phy_ac_op_allocate(struct b43_wldev *dev)
 {
 	struct b43_phy_ac *phy_ac;
+
+	/*
+	 * Refuse an unverified frontend before AC analog/radio callbacks can
+	 * run. Skipping only its table later in op_init still allows the rest
+	 * of the bring-up with an unknown PA and antenna-switch mapping.
+	 */
+	if (!b43_phy_ac_fem_lookup(dev)) {
+		b43err(dev->wl,
+		       "AC-PHY: refusing unsupported frontend femctrl=%u sub=%u\n",
+		       dev->dev->bus_sprom->femctrl,
+		       dev->dev->bus_sprom->boardflags3 & 0x7);
+		return -EOPNOTSUPP;
+	}
 
