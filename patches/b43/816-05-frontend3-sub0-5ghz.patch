+/*
+ * The 6.37 frontend-3 selector clears PHY 0x040a[8], sets regctl0[2],
+ * and sets the chipcontrol frontend pins to 0x10 before table writes.
+ * The R7000 5 GHz capture confirms regctl0=0x00200004 and chipcontrol
+ * 0x10 around the table; preserve chipcontrol bits outside the mask.
+ */
+static void b43_phy_ac_fem3_sub0_pre(struct b43_wldev *dev)
+{
+	struct bcma_drv_cc *cc = &dev->dev->bdev->bus->drv_cc;
+
+	b43_phy_mask(dev, 0x040a, (u16)~0x0100);
+	bcma_chipco_regctl_maskset(cc, 0, ~0x00000004U, 0x00000004U);
+	bcma_cc_maskset32(cc, BCMA_CC_CHIPCTL, ~0x00fffffdU, 0x00000010U);
+}
