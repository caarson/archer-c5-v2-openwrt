+/* Bounded RAM-trial flow observer at the MAC-to-IP-stack boundary.
+ * eth_type_trans() has removed Ethernet in every caller of this hook.
+ * Copies only IPv4(20), TCP prefix(8) or ICMP type(1), never application data.
+ * Protocol checksum validation occurs later: counts indicate this boundary,
+ * not successful TCP delivery. Per-port slots distinguish control/data flows.
+ */
+#define PHASE3_FLOW_SLOTS 8
+static bool phase3_flow_diag;
+module_param_named(phase3_flow_diag, phase3_flow_diag, bool, 0400);
+MODULE_PARM_DESC(phase3_flow_diag, "Enable bounded fixed-tuple RAM MAC delivery counters");
+struct phase3_flow_slot {
+ atomic_t port, packets, ip_bytes;
+ u32 last_sequence;
+ unsigned long last_j;
+};
+static struct phase3_flow_slot phase3_flow_slots[PHASE3_FLOW_SLOTS];
+static atomic_t phase3_flow_gateway_reply, phase3_flow_slot_full;
+
+static void phase3_flow_add(atomic_t *counter, unsigned int amount)
+{
+ int old = atomic_read(counter), next, seen;
+ while (old < INT_MAX) {
+  next = old + min_t(unsigned int, amount, INT_MAX - old);
+  seen = atomic_cmpxchg(counter, old, next);
+  if (seen == old)
+   return;
+  old = seen;
+ }
+}
+
+static void phase3_flow_observe(struct sk_buff *skb,
+                               const struct ieee80211_rx_data *rx)
+{
+ static const u8 source[4] = {192,168,0,134};
+ static const u8 target[4] = {192,168,0,146};
+ static const u8 gateway[4] = {192,168,0,1};
+ u8 ip[20], l4[8];
+ unsigned int hlen, total, fragment, port, i;
+ u32 sequence;
+ if (!READ_ONCE(phase3_flow_diag) || !rx->sta ||
+     rx->sdata->vif.type != NL80211_IFTYPE_STATION ||
+     skb->protocol != cpu_to_be16(ETH_P_IP))
+  return;
+ if (skb_copy_bits(skb, 0, ip, sizeof(ip)) || (ip[0] >> 4) != 4)
+  return;
+ hlen = (ip[0] & 15) * 4;
+ total = ((unsigned int)ip[2] << 8) | ip[3];
+ fragment = ((unsigned int)ip[6] << 8) | ip[7];
+ if (hlen < 20 || total < hlen || total > skb->len ||
+     (fragment & 0x1fff) || memcmp(ip + 16, target, 4))
+  return;
+ if (ip[9] == 1 && !memcmp(ip + 12, gateway, 4)) {
+  if (total >= hlen + 1 && !skb_copy_bits(skb, hlen, l4, 1) &&
+      l4[0] == 0)
+   phase3_flow_add(&phase3_flow_gateway_reply, 1);
+  return;
+ }
+ if (ip[9] != 6 || memcmp(ip + 12, source, 4) ||
+     total < hlen + 8 || skb_copy_bits(skb, hlen, l4, 8) ||
+     (((unsigned int)l4[0] << 8) | l4[1]) != 5209)
+  return;
+ port = ((unsigned int)l4[2] << 8) | l4[3];
+ if (!port)
+  return;
+ sequence = ((u32)l4[4] << 24) | ((u32)l4[5] << 16) |
+            ((u32)l4[6] << 8) | l4[7];
+ for (i = 0; i < PHASE3_FLOW_SLOTS; i++) {
+  struct phase3_flow_slot *slot = &phase3_flow_slots[i];
+  int key = atomic_read(&slot->port);
+  if (!key)
+   key = atomic_cmpxchg(&slot->port, 0, port);
+  if (key && key != (int)port)
+   continue;
+  phase3_flow_add(&slot->packets, 1);
+  phase3_flow_add(&slot->ip_bytes, total);
+  WRITE_ONCE(slot->last_sequence, sequence);
+  WRITE_ONCE(slot->last_j, jiffies);
+  return;
+ }
+ phase3_flow_add(&phase3_flow_slot_full, 1);
+}
+
+static int phase3_flow_get(char *buffer, const struct kernel_param *unused)
+{
+ unsigned int i;
+ int n = 0;
+ n += scnprintf(buffer + n, PAGE_SIZE - n,
+      "schema=1 enabled=%u source=192.168.0.134 target=192.168.0.146 sport=5209 gateway=192.168.0.1 slots=8 ip_checksum_not_yet_validated=1 saturates_at=%u\n",
+      READ_ONCE(phase3_flow_diag), INT_MAX);
+ n += scnprintf(buffer + n, PAGE_SIZE - n,
+      "gateway_echo_replies=%d slot_full=%d\n",
+      atomic_read(&phase3_flow_gateway_reply), atomic_read(&phase3_flow_slot_full));
+ for (i = 0; i < PHASE3_FLOW_SLOTS && n < PAGE_SIZE - 1; i++) {
+  struct phase3_flow_slot *slot = &phase3_flow_slots[i];
+  int port = atomic_read(&slot->port);
+  if (port)
+   n += scnprintf(buffer + n, PAGE_SIZE - n,
+        "slot=%u dport=%d packets=%d ip_bytes=%d last_sequence=%08x last_j=%lu\n",
+        i, port, atomic_read(&slot->packets), atomic_read(&slot->ip_bytes),
+        READ_ONCE(slot->last_sequence), READ_ONCE(slot->last_j));
+ }
+ return n;
+}
+static const struct kernel_param_ops phase3_flow_ops = {
+ .get = phase3_flow_get,
+};
+module_param_cb(phase3_flow_snapshot, &phase3_flow_ops, NULL, 0400);
 
