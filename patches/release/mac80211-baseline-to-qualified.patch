+/*
+ * RAM-trial observer only. Count the already-decided station drop reason.
+ * No packet/crypto/key data is read or modified. Fixed, saturating atomics;
+ * no allocations, locks or logging in the packet path. The read-only module
+ * parameter is an approximate counter snapshot, not a coherent transaction.
+ */
+#define PHASE3_RX_REASON_MAX 64U
+static bool phase3_rx_diag;
+module_param_named(phase3_rx_diag, phase3_rx_diag, bool, 0400);
+MODULE_PARM_DESC(phase3_rx_diag, "Enable bounded RAM-trial station RX drop counters");
+
+static atomic_t phase3_rx_reasons[PHASE3_RX_REASON_MAX + 1];
+static const char * const phase3_rx_reason_names[] = {
+	"RX_DROP",
+#define PHASE3_RX_LABEL(x) #x,
+	MAC80211_DROP_REASONS_UNUSABLE(PHASE3_RX_LABEL)
+#undef PHASE3_RX_LABEL
+};
+
+static void phase3_rx_drop_count(ieee80211_rx_result result)
+{
+	u32 index;
+
+	if (!READ_ONCE(phase3_rx_diag))
+		return;
+	index = (__force u32)result - (__force u32)RX_DROP;
+	if (index >= PHASE3_RX_REASON_MAX)
+		index = PHASE3_RX_REASON_MAX;
+	atomic_add_unless(&phase3_rx_reasons[index], 1, INT_MAX);
+}
+
+static int phase3_rx_drop_get(char *buffer, const struct kernel_param *unused)
+{
+	unsigned int i;
+	int offset = 0;
+
+	offset += scnprintf(buffer + offset, PAGE_SIZE - offset,
+			    "schema=1 enabled=%u station_handlers_only=1 max_reason=%u saturates_at=%u\n",
+			    READ_ONCE(phase3_rx_diag), PHASE3_RX_REASON_MAX,
+			    INT_MAX);
+	for (i = 0; i <= PHASE3_RX_REASON_MAX && offset < PAGE_SIZE - 1; i++) {
+		int count = atomic_read(&phase3_rx_reasons[i]);
+		const char *name = i < ARRAY_SIZE(phase3_rx_reason_names) ?
+				  phase3_rx_reason_names[i] : "unknown";
+
+		if (count)
+			offset += scnprintf(buffer + offset, PAGE_SIZE - offset,
+					    "reason=%u name=%s count=%d\n",
+					    i, name, count);
+	}
+	return offset;
+}
