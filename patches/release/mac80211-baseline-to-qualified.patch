+/* Opt-in defensive trial guard at the observed PN-update boundary.
+ * A noncanonical IV on a frame merely labelled decrypted must not poison
+ * replay state. This does not establish why that IV reached mac80211.
+ * Normal software MIC verification and all PN comparisons remain intact.
+ */
+static bool phase3_ccmp_iv_guard;
+module_param_named(phase3_ccmp_iv_guard, phase3_ccmp_iv_guard, bool, 0400);
+MODULE_PARM_DESC(phase3_ccmp_iv_guard, "Trial guard for noncanonical hardware-decrypted CCMP IV");
+
+static bool phase3_ccmp_iv_canonical(const u8 *iv, size_t length)
+{
+	return length >= 8 && iv[2] == 0 && (iv[3] & 0x3f) == 0x20;
+}
+
+/* RAM-only PN transition observer. Never reads key bytes or changes validation.
+ * Records at most two initial, two >65536 jumps, and eight replay events.
+ * PN/IV are wire-header metadata; only already-validated CCMP/GCMP offsets
+ * are observed. No payload capture, allocations or logging in the RX path.
+ */
+#define PHASE3_PN_RECORDS 12U
+static bool phase3_pn_diag;
+module_param_named(phase3_pn_diag, phase3_pn_diag, bool, 0400);
+MODULE_PARM_DESC(phase3_pn_diag, "Enable bounded RAM-trial pairwise PN metadata");
+
+struct phase3_pn_record {
+	u64 flags;
+	u32 observed_jiffies, key_color, cipher, length;
+	u16 sequence, frame_control, header_length;
+	u8 queue, key_index, kind;
+	u8 pn[6], previous[6], iv[8];
+};
+static struct phase3_pn_record phase3_pn_records[PHASE3_PN_RECORDS];
+static unsigned int phase3_pn_count, phase3_pn_kinds[3];
+static const unsigned int phase3_pn_limits[3] = { 2, 2, 8 };
+static DEFINE_SPINLOCK(phase3_pn_lock);
+
+#include "phase3_trigger_pn.h"
+
+static u64 phase3_pn_value(const u8 *pn)
+{
+	return ((u64)pn[0] << 40) | ((u64)pn[1] << 32) |
+	       ((u64)pn[2] << 24) | ((u64)pn[3] << 16) |
+	       ((u64)pn[4] << 8) | pn[5];
+}
+
+static void phase3_pn_observe(struct ieee80211_rx_data *rx, const u8 *pn,
+			     const u8 *previous, const u8 *iv,
+			     int header_length, bool replay)
+{
+	struct phase3_pn_record *record;
+	struct ieee80211_hdr *header;
+	struct ieee80211_rx_status *status;
+	unsigned long irq_flags;
+	u64 value, old;
+	unsigned int kind;
+	int queue = rx->security_idx;
+
+	if (!READ_ONCE(phase3_pn_diag) || !rx->key ||
+	    !(rx->key->conf.flags & IEEE80211_KEY_FLAG_PAIRWISE) ||
+	    rx->sdata->vif.type != NL80211_IFTYPE_STATION ||
+	    queue < 0 || queue > IEEE80211_NUM_TIDS ||
+	    header_length < 24 || header_length > 36 ||
+	    rx->skb->len < (unsigned int)header_length + 8)
+		return;
+	phase3_reorder_pn_observe(rx, pn, previous, iv, header_length,
+				 replay ? 1 : 0);
+	if (replay) {
+		kind = 2;
+	} else {
+		old = phase3_pn_value(previous);
+		value = phase3_pn_value(pn);
+		if (!old)
+			kind = 0;
+		else if (value > old && value - old > 65536)
+			kind = 1;
+		else
+			return;
+	}
+	if (READ_ONCE(phase3_pn_kinds[kind]) >= phase3_pn_limits[kind])
+		return;
+	header = (void *)rx->skb->data;
+	status = IEEE80211_SKB_RXCB(rx->skb);
+	spin_lock_irqsave(&phase3_pn_lock, irq_flags);
+	if (phase3_pn_count >= PHASE3_PN_RECORDS ||
+	    phase3_pn_kinds[kind] >= phase3_pn_limits[kind])
+		goto out;
+	record = &phase3_pn_records[phase3_pn_count];
+	record->flags = status->flag;
+	record->observed_jiffies = (u32)jiffies;
+	record->key_color = rx->key->color;
+	record->cipher = rx->key->conf.cipher;
+	record->length = rx->skb->len;
+	record->sequence = le16_to_cpu(header->seq_ctrl);
+	record->frame_control = le16_to_cpu(header->frame_control);
+	record->header_length = header_length;
+	record->queue = queue;
+	record->key_index = rx->key->conf.keyidx;
+	record->kind = kind;
+	memcpy(record->pn, pn, 6);
+	memcpy(record->previous, previous, 6);
+	memcpy(record->iv, iv, 8);
+	phase3_pn_kinds[kind]++;
+	phase3_pn_count++;
+out:
+	spin_unlock_irqrestore(&phase3_pn_lock, irq_flags);
+}
+
+static void phase3_pn_hex(char *destination, const u8 *source, unsigned int size)
+{
+	static const char hex[] = "0123456789abcdef";
+	unsigned int i;
+
+	for (i = 0; i < size; i++) {
+		destination[2 * i] = hex[source[i] >> 4];
+		destination[2 * i + 1] = hex[source[i] & 15];
+	}
+	destination[2 * size] = 0;
+}
+
+static int phase3_pn_get(char *buffer, const struct kernel_param *unused)
+{
+	struct phase3_pn_record copy[PHASE3_PN_RECORDS];
+	unsigned long irq_flags;
+	unsigned int i, count;
+	int offset = 0;
+	char pn[13], previous[13], iv[17];
+
+	spin_lock_irqsave(&phase3_pn_lock, irq_flags);
+	count = min(phase3_pn_count, PHASE3_PN_RECORDS);
+	memcpy(copy, phase3_pn_records, sizeof(copy));
+	spin_unlock_irqrestore(&phase3_pn_lock, irq_flags);
+	offset += scnprintf(buffer + offset, PAGE_SIZE - offset,
+			    "schema=1 enabled=%u records=%u max=%u pairwise_station_only=1 kinds=0:initial,1:jump_gt65536,2:replay\n",
+			    READ_ONCE(phase3_pn_diag), count, PHASE3_PN_RECORDS);
+	for (i = 0; i < count && offset < PAGE_SIZE - 1; i++) {
+		const struct phase3_pn_record *record = &copy[i];
+
+		phase3_pn_hex(pn, record->pn, 6);
+		phase3_pn_hex(previous, record->previous, 6);
+		phase3_pn_hex(iv, record->iv, 8);
+		offset += scnprintf(buffer + offset, PAGE_SIZE - offset,
+				    "kind=%u j=%u key_color=%u cipher=%08x queue=%u key_index=%u flags=%016llx sequence=%04x fc=%04x length=%u hdr=%u pn=%s previous=%s iv=%s\n",
+				    record->kind, record->observed_jiffies,
+				    record->key_color, record->cipher,
+				    record->queue, record->key_index,
+				    (unsigned long long)record->flags,
+				    record->sequence, record->frame_control,
+				    record->length, record->header_length,
+				    pn, previous, iv);
+	}
+	return offset;
+}
+static const struct kernel_param_ops phase3_pn_ops = {
+	.get = phase3_pn_get,
+};
+module_param_cb(phase3_pn_snapshot, &phase3_pn_ops, NULL, 0400);
 
